{
  "name": "@chromeuse/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing Chrome browser tools for ChromeUse",
  "license": "MIT",
  "type": "module",
  "main": "dist/library.js",
  "types": "dist/library.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./bin": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "chromeuse-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@chromeuse/shared": "*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
