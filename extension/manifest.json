{
  "manifest_version": 3,
  "name": "OpenCode Browser",
  "version": "0.1.0",
  "description": "Browser automation tools for OpenCode",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "nativeMessaging",
    "offscreen",
    "downloads",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/service-worker/index.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_title": "OpenCode Browser"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content-scripts/visualIndicator.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content-scripts/accessibilityTree.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
