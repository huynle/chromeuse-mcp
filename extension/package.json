{
  "name": "@chromeuse/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension (MV3) for ChromeUse MCP browser automation",
  "type": "module",
  "scripts": {
    "build": "tsx esbuild.config.ts",
    "build:watch": "tsx esbuild.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@chromeuse/shared": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
